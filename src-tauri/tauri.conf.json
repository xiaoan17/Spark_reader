{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "框选精读",
  "version": "0.1.0",
  "identifier": "com.anbc.focused-reading",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "框选精读",
        "width": 1280,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "resources": {}
  }
}
