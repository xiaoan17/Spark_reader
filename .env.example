# 环境变量示例 — 复制为 .env 并填入真实值
# .env 已被 .gitignore 忽略,绝不提交到版本库

# MinerU 开放 API(精度版 api/v4)
# 在 https://mineru.net/apiManage/docs 获取/管理你的 token
MINERU_API_TOKEN=

# ── LLM 后端(多 provider 可配置,见 docs/llm-provider.md)──
# 默认 provider: deepseek | openai | anthropic
LLM_PROVIDER=deepseek

# DeepSeek(OpenAI 兼容协议)
# API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
# API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini

# Anthropic
# API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Embedding 后端(只走外部 provider;不内置/本地部署 embedding 模型)──
# 兼容 OpenAI embeddings 协议的 provider 均可;disabled 表示仅使用 FTS 文本检索
# 当前预置 SiliconFlow + Qwen3;填入 EMBEDDING_API_KEY 后即可启用 provider embedding
# SiliconFlow API key: https://cloud.siliconflow.cn/account/ak
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
EMBEDDING_DIM=2560

# ── 检索调参(可选)──
# 自定义术语扩展,格式: 术语=扩展词1 扩展词2;术语2=扩展词
# 未设置时使用内置通用词表;显式设为空字符串时仅使用词法/CJK topic 扩展
# FOCUSED_READING_CONCEPT_PAIRS="叙事=视角 结构 节奏;氧化=电子 转移 还原"

# ── 内置 OpenCode agent host(可选覆盖;默认沿用上面的 LLM_PROVIDER 配置)──
FOCUSED_READING_OPENCODE_HOST=127.0.0.1
FOCUSED_READING_OPENCODE_PORT=48172
FOCUSED_READING_AGENT_CONFIG_PORT=48174
FOCUSED_READING_BOOK_TOOL_BASE_URL=http://127.0.0.1:48173
FOCUSED_READING_BOOK_TOOL_TOKEN=
